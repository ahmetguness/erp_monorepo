{
  "groups": [
    {
      "name": "axon-operational",
      "interval": "15s",
      "rules": [
        {
          "alert": "CriticalPaymentWebhookFailure",
          "expr": "increase(axon_payment_webhook_failures_total[5m]) > 0",
          "for": "0s",
          "labels": {
            "severity": "critical",
            "service": "payments"
          },
          "annotations": {
            "summary": "Payment or webhook returned a server error; reconcile before retry",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#payments"
          }
        },
        {
          "alert": "EDocumentBacklog",
          "expr": "axon_edocument_oldest_seconds > 300",
          "for": "1m",
          "labels": {
            "severity": "warning",
            "service": "edocument"
          },
          "annotations": {
            "summary": "Unfinished electronic document exceeds 5min operational target",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#edocument"
          }
        },
        {
          "alert": "RealtimeUnconfirmedDelivery",
          "expr": "increase(axon_realtime_unconfirmed_deliveries_total[5m]) > 0 or increase(axon_realtime_ack_tracking_overflow_total[5m]) > 0",
          "for": "30s",
          "labels": {
            "severity": "warning",
            "service": "chat"
          },
          "annotations": {
            "summary": "Opted-in client did not confirm delivery or bounded receipt tracking overflowed",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#websocket"
          }
        },
        {
          "alert": "StorageMetadataMismatch",
          "expr": "axon_storage_metadata_mismatches > 0",
          "for": "30s",
          "labels": {
            "severity": "critical",
            "service": "storage"
          },
          "annotations": {
            "summary": "Committed object metadata and tenant storage accounting disagree",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#storage"
          }
        },
        {
          "alert": "ApiReplicaDown",
          "expr": "up{job=\"axon-api\"} == 0",
          "for": "30s",
          "labels": {
            "severity": "critical",
            "service": "api"
          },
          "annotations": {
            "summary": "API replica scrape is unavailable",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#api-replica"
          }
        },
        {
          "alert": "PostgresProbeFailure",
          "expr": "axon_operational_probe_up == 0",
          "for": "30s",
          "labels": {
            "severity": "critical",
            "service": "postgres"
          },
          "annotations": {
            "summary": "Independent database probe failed or exceeded its budget",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#postgres"
          }
        },
        {
          "alert": "ApiErrorBudget",
          "expr": "sum(rate(axon_http_request_duration_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum(rate(axon_http_request_duration_seconds_count[5m])), 0.001) > 0.005",
          "for": "2m",
          "labels": {
            "severity": "critical",
            "service": "api"
          },
          "annotations": {
            "summary": "API 5xx ratio exceeds 0.5%",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#api-errors"
          }
        },
        {
          "alert": "ApiReadLatency",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(axon_http_request_duration_seconds_bucket{method=\"GET\",route!=\"/metrics\"}[5m]))) > 0.3",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "service": "api"
          },
          "annotations": {
            "summary": "Read p95 exceeds Phase 8.2 300ms",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#api-errors"
          }
        },
        {
          "alert": "ApiWriteLatency",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(axon_http_request_duration_seconds_bucket{method=~\"POST|PUT|PATCH|DELETE\"}[5m]))) > 0.8",
          "for": "5m",
          "labels": {
            "severity": "warning",
            "service": "api"
          },
          "annotations": {
            "summary": "Write p95 exceeds Phase 8.2 800ms",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#api-errors"
          }
        },
        {
          "alert": "PostgresContention",
          "expr": "axon_postgres_lock_waiters > 0 or increase(axon_postgres_deadlocks_total[5m]) > 0 or increase(axon_database_pool_timeouts_total[5m]) > 0",
          "for": "1m",
          "labels": {
            "severity": "warning",
            "service": "postgres"
          },
          "annotations": {
            "summary": "Database contention or exhausted pool",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#postgres"
          }
        },
        {
          "alert": "RedisUnavailable",
          "expr": "axon_dependency_up{dependency=\"redis\"} == 0",
          "for": "30s",
          "labels": {
            "severity": "critical",
            "service": "redis"
          },
          "annotations": {
            "summary": "Redis readiness probe failed",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#redis"
          }
        },
        {
          "alert": "WorkerUnavailable",
          "expr": "axon_dependency_up{dependency=\"worker\"} == 0",
          "for": "30s",
          "labels": {
            "severity": "critical",
            "service": "worker"
          },
          "annotations": {
            "summary": "Worker heartbeat is unavailable",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#worker"
          }
        },
        {
          "alert": "OutboxBacklog",
          "expr": "axon_outbox_oldest_seconds > 30",
          "for": "1m",
          "labels": {
            "severity": "warning",
            "service": "worker"
          },
          "annotations": {
            "summary": "Oldest queued event exceeds Phase 8.2 30s",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#worker"
          }
        },
        {
          "alert": "OutboxDeadLetter",
          "expr": "axon_outbox_dead_letter > 0 or axon_worker_dead_letter > 0",
          "for": "30s",
          "labels": {
            "severity": "critical",
            "service": "worker"
          },
          "annotations": {
            "summary": "Dead-letter work requires operator intervention",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#dead-letter"
          }
        },
        {
          "alert": "OutboxExpiredLease",
          "expr": "axon_outbox_expired_leases > 0",
          "for": "1m",
          "labels": {
            "severity": "warning",
            "service": "worker"
          },
          "annotations": {
            "summary": "Expired outbox processing lease",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#worker"
          }
        },
        {
          "alert": "ProviderFailure",
          "expr": "increase(axon_provider_connection_failures_total[5m]) > 0 or increase(axon_provider_rate_limits_total[5m]) > 0 or increase(axon_provider_server_errors_total[5m]) > 0",
          "for": "30s",
          "labels": {
            "severity": "warning",
            "service": "provider"
          },
          "annotations": {
            "summary": "Provider timeout, connection, 429 or 5xx failure",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#provider"
          }
        },
        {
          "alert": "WebSocketFailure",
          "expr": "increase(axon_realtime_failures_total[5m]) > 0",
          "for": "30s",
          "labels": {
            "severity": "warning",
            "service": "chat"
          },
          "annotations": {
            "summary": "Realtime transport failure; verify receipt completeness",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#websocket"
          }
        },
        {
          "alert": "StorageUnavailable",
          "expr": "axon_dependency_up{dependency=\"storage\"} == 0",
          "for": "30s",
          "labels": {
            "severity": "critical",
            "service": "storage"
          },
          "annotations": {
            "summary": "Storage readiness probe failed",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#storage"
          }
        },
        {
          "alert": "StorageCleanupExhausted",
          "expr": "axon_storage_cleanup_exhausted > 0",
          "for": "30s",
          "labels": {
            "severity": "critical",
            "service": "storage"
          },
          "annotations": {
            "summary": "Bounded object cleanup exhausted its attempts",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#storage"
          }
        },
        {
          "alert": "BusinessInvariantViolation",
          "expr": "axon_business_invariant_violations > 0",
          "for": "0s",
          "labels": {
            "severity": "critical",
            "service": "integrity"
          },
          "annotations": {
            "summary": "Independent SQL business invariant violation",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#business-invariants"
          }
        },
        {
          "alert": "AuditIntegrityFailure",
          "expr": "axon_audit_integrity_valid == 0",
          "for": "0s",
          "labels": {
            "severity": "critical",
            "service": "security"
          },
          "annotations": {
            "summary": "Audit chain verification failed",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#audit-integrity"
          }
        },
        {
          "alert": "BackupFailure",
          "expr": "axon_dr_repository_up == 0 or axon_dr_backup_failure == 1 or time() - axon_dr_backup_last_success_seconds > 93600",
          "for": "1m",
          "labels": {
            "severity": "critical",
            "service": "dr"
          },
          "annotations": {
            "summary": "Backup failed, repository inaccessible or full backup older than 26h",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#backup"
          }
        },
        {
          "alert": "WalArchiveStale",
          "expr": "axon_dr_wal_age_seconds > 900 or axon_dr_archive_failure == 1",
          "for": "1m",
          "labels": {
            "severity": "critical",
            "service": "dr"
          },
          "annotations": {
            "summary": "WAL archive freshness exceeds 15min or archive failed",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#wal-archive"
          }
        },
        {
          "alert": "DrFeedMissing",
          "expr": "absent(axon_dr_probe_up) or axon_dr_probe_up == 0 or time() - axon_dr_probe_timestamp_seconds > 120",
          "for": "2m",
          "labels": {
            "severity": "critical",
            "service": "dr"
          },
          "annotations": {
            "summary": "Independent DR telemetry is missing, failing or stale",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#backup"
          }
        },
        {
          "alert": "AuthenticationAnomaly",
          "expr": "increase(axon_authentication_failures_total[5m]) > 20",
          "for": "1m",
          "labels": {
            "severity": "warning",
            "service": "security"
          },
          "annotations": {
            "summary": "Elevated authentication/MFA failures",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#authentication"
          }
        },
        {
          "alert": "TelemetryLoss",
          "expr": "increase(axon_telemetry_dropped_spans_total[5m]) > 0 or increase(axon_log_export_dropped_total[5m]) > 0 or axon_telemetry_configuration_valid == 0",
          "for": "30s",
          "labels": {
            "severity": "warning",
            "service": "monitoring"
          },
          "annotations": {
            "summary": "Diagnostic export is unavailable or dropping bounded buffers",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#monitoring"
          }
        },
        {
          "alert": "ClockSkew",
          "expr": "axon_database_clock_offset_seconds > 5",
          "for": "2m",
          "labels": {
            "severity": "warning",
            "service": "security"
          },
          "annotations": {
            "summary": "Database and application clocks differ by more than 5s",
            "runbook_url": "https://github.com/ahmetguness/erp_monorepo/blob/main/docs/operations-runbooks.md#clock"
          }
        }
      ]
    }
  ]
}
