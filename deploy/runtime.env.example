# Copy outside the repository; chmod 600. Keep staging and production credentials separate.
# Database URL is the application pool; migrations always use the direct connection.
DATABASE_URL=postgresql://USER:PASSWORD@POOL_HOST:5432/axon?schema=public&connection_limit=5&pool_timeout=10
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/axon?schema=public
REDIS_URL=rediss://USER:PASSWORD@REDIS_HOST:6379
APP_URL=https://erp.example.com
ALLOWED_ORIGINS=https://erp.example.com
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_JWT_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_ENCRYPTION_KEY
API_KEY_PEPPER=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
STORAGE_DRIVER=s3
S3_ENDPOINT=https://OBJECT_STORAGE_ENDPOINT
S3_REGION=auto
S3_ACCESS_KEY_ID=REPLACE
S3_SECRET_ACCESS_KEY=REPLACE
S3_BUCKET=axon-private-documents
MALWARE_SCAN_MODE=enforce
MALWARE_SCAN_ENDPOINT=https://PRIVATE_SCANNER_ENDPOINT/scan
METRICS_ENABLED=false
RESEND_API_KEY=REPLACE
RESEND_FROM_EMAIL=Axon ERP <noreply@example.com>
# AI is disabled unless a provider is explicitly configured.
# OPENAI_API_KEY=
# Use an immutable Caddy 2 digest; do not use latest in an environment file.
PROXY_IMAGE=caddy@sha256:REPLACE_WITH_VERIFIED_IMAGE_DIGEST
