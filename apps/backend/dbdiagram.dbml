Table invoices {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  contactId varchar
  salesOrderId varchar [null]
  purchaseOrderId varchar [null]
  type InvoiceType
  status InvoiceStatus [default: 'DRAFT']
  number varchar
  date timestamp
  dueDate timestamp [null]
  currencyCode varchar [default: 'TRY']
  exchangeRate decimal [default: 1]
  totalNet decimal [default: 0]
  totalTax decimal [default: 0]
  totalGross decimal [default: 0]
  notes varchar [null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  deletedAt timestamp [null]
  createdById varchar [null]
  updatedById varchar [null]
  totalWithholding decimal [default: 0]
  postingIdempotencyKey varchar [null]

  indexes {
    (tenantId, number) [unique]
    (tenantId, postingIdempotencyKey) [unique]
    (tenantId, status)
    (tenantId, contactId)
    (tenantId, date)
    (tenantId, dueDate)
    (tenantId, status, dueDate)
    (tenantId, type, status)
    (tenantId, salesOrderId, type)
    (tenantId, purchaseOrderId, type)
    (deletedAt)
  }
}

Table invoice_lines {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  invoiceId varchar
  productId varchar [null]
  taxRateId varchar [null]
  withholdingRateId varchar [null]
  description varchar
  quantity decimal
  unitPrice decimal
  discount decimal [default: 0]
  taxAmount decimal [default: 0]
  withholdingAmount decimal [default: 0]
  lineTotal decimal
  sortOrder integer [default: 0]

  indexes {
    (tenantId, invoiceId)
  }
}

Table invoice_history {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  invoiceId varchar
  fromStatus InvoiceStatus [null]
  toStatus InvoiceStatus
  notes varchar [null]
  createdAt timestamp [default: `now()`]
  createdById varchar [null]

  indexes {
    (tenantId, invoiceId)
  }
}

Table e_documents {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  invoiceId varchar [null]
  deliveryNoteId varchar [null]
  type EDocumentType
  status EDocumentStatus [default: 'PENDING']
  uuid varchar [unique, null]
  providerCode varchar [null]
  providerMessage varchar [null]
  requestPayload jsonb [null]
  responsePayload jsonb [null]
  retryCount integer [default: 0]
  lastRetryAt timestamp [null]
  sentAt timestamp [null]
  acceptedAt timestamp [null]
  rejectedAt timestamp [null]
  cancelledAt timestamp [null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  submissionIdempotencyKey varchar [null]

  indexes {
    (tenantId, submissionIdempotencyKey) [unique]
    (tenantId, status)
    (tenantId, invoiceId)
    (tenantId, deliveryNoteId)
  }
}

Table bank_accounts {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  name varchar
  accountNumber varchar [null]
  iban varchar [null, note: 'NULL values are excluded from the unique constraint in PostgreSQL (NULL != NULL), so multiple rows with NULL iban are allowed']
  bankName varchar [null]
  branchName varchar [null]
  branchCode varchar [null]
  currencyCode varchar [default: 'TRY']
  type BankAccountType [default: 'CHECKING']
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  deletedAt timestamp [null]
  createdById varchar [null]

  indexes {
    (tenantId, iban) [unique]
    (tenantId, isActive)
    (deletedAt)
  }
}

Table cash_accounts {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  name varchar
  currencyCode varchar [default: 'TRY']
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  deletedAt timestamp [null]
  createdById varchar [null]

  indexes {
    (tenantId, isActive)
    (deletedAt)
  }
}

Table bank_transactions {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  bankAccountId varchar
  type BankTransactionType
  amount decimal
  balanceAfter decimal
  date timestamp
  description varchar [null]
  reference varchar [null]
  refType BankTransactionRefType [null]
  refId varchar [null]
  createdAt timestamp [default: `now()`]
  createdById varchar [null]

  indexes {
    (tenantId, bankAccountId)
    (tenantId, date)
    (refType, refId)
  }
}

Table check_promissory_notes {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  contactId varchar [null]
  type CheckNoteType
  number varchar
  amount decimal
  currencyCode varchar [default: 'TRY']
  issueDate timestamp
  dueDate timestamp
  bankName varchar [null]
  status CheckStatus [default: 'PENDING']
  notes varchar [null]
  deletedAt timestamp [null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  createdById varchar [null]

  indexes {
    (tenantId, number) [unique]
    (tenantId, status)
    (tenantId, dueDate)
    (tenantId, contactId)
    (deletedAt)
  }
}

Table payments {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  contactId varchar [null]
  bankAccountId varchar [null]
  cashAccountId varchar [null]
  checkNoteId varchar [null]
  date timestamp
  amount decimal
  method PaymentMethod [default: 'CASH']
  direction varchar [default: 'RECEIVE']
  reference varchar [null]
  idempotencyKey varchar [null]
  status PaymentStatus [default: 'PENDING']
  notes varchar [null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  deletedAt timestamp [null]
  createdById varchar [null]

  indexes {
    (tenantId, idempotencyKey) [unique]
    (tenantId, status)
    (tenantId, date)
    (tenantId, contactId)
  }
}

Table payment_allocations {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  paymentId varchar
  invoiceId varchar
  amount decimal
  createdAt timestamp [default: `now()`]

  indexes {
    (paymentId, invoiceId) [unique]
    (tenantId, paymentId)
    (tenantId, invoiceId)
  }
}

Table ledger_accounts {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  code varchar
  name varchar
  parentId varchar [null]
  isActive boolean [default: true]
  accountType AccountType [default: 'ASSET']
  deletedAt timestamp [null]

  indexes {
    (tenantId, code) [unique]
    (tenantId, isActive)
    (deletedAt)
  }
}

Table fiscal_periods {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  name varchar
  startDate timestamp
  endDate timestamp
  status FiscalPeriodStatus [default: 'OPEN']
  closedAt timestamp [null]
  closedById varchar [null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']

  indexes {
    (tenantId, startDate, endDate) [unique]
    (tenantId, status)
  }
}

Table journal_entries {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  fiscalPeriodId varchar [null]
  type JournalEntryType
  number varchar
  date timestamp
  description varchar [null]
  refType varchar [null]
  refId varchar [null]
  isPosted boolean [default: false]
  postedAt timestamp [null]
  postedById varchar [null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  createdById varchar [null]
  idempotencyKey varchar [null]

  indexes {
    (tenantId, number) [unique]
    (tenantId, idempotencyKey) [unique]
    (tenantId, date)
    (tenantId, isPosted)
    (refType, refId)
  }
}

Table journal_entry_lines {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  journalEntryId varchar
  accountId varchar
  debit decimal [default: 0]
  credit decimal [default: 0]
  description varchar [null]
  sortOrder integer [default: 0]

  indexes {
    (tenantId, journalEntryId)
    (tenantId, accountId)
  }
}

Table reconciliations {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  name varchar
  description varchar [null]
  date timestamp
  isFinalized boolean [default: false]
  finalizedAt timestamp [null]
  finalizedById varchar [null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  createdById varchar [null]

  indexes {
    (tenantId, date)
  }
}

Table reconciliation_lines {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  reconciliationId varchar
  accountId varchar
  refType varchar [null]
  refId varchar [null]
  amount decimal
  isMatched boolean [default: false]
  notes varchar [null]

  indexes {
    (tenantId, reconciliationId)
  }
}

Table collection_reminders {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  contactId varchar
  invoiceId varchar [null]
  amount decimal
  dueDate timestamp
  status varchar [default: 'PENDING']
  notes varchar [null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']

  indexes {
    (tenantId)
  }
}

Table employees {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  firstName varchar
  lastName varchar
  email varchar [null]
  phone varchar [null]
  position varchar [null]
  department varchar [null]
  hireDate timestamp
  leaveDate timestamp [null]
  salary decimal [default: 0]
  isActive boolean [default: true]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  deletedAt timestamp [null]
  createdById varchar [null]
  updatedById varchar [null]

  indexes {
    (tenantId, isActive)
    (tenantId, department)
    (deletedAt)
  }
}

Table leave_requests {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  employeeId varchar
  type LeaveType
  status LeaveStatus [default: 'PENDING']
  startDate timestamp
  endDate timestamp
  days decimal
  notes varchar [null]
  approvedBy varchar [null]
  approvedAt timestamp [null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  deletedAt timestamp [null]

  indexes {
    (tenantId, employeeId)
    (tenantId, status)
  }
}

Table attendances {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  employeeId varchar
  date timestamp
  checkIn timestamp [null]
  checkOut timestamp [null]
  overtimeHours decimal [default: 0]
  notes varchar [null]
  updatedAt timestamp [note: 'Automatically updated timestamp']

  indexes {
    (employeeId, date) [unique]
    (tenantId, date)
  }
}

Table payrolls {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  employeeId varchar
  period varchar
  grossSalary decimal
  deductions decimal [default: 0]
  netSalary decimal
  paidAt timestamp [null]
  notes varchar [null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  deletedAt timestamp [null]
  createdById varchar [null]

  indexes {
    (tenantId, employeeId, period) [unique]
    (tenantId, period)
    (deletedAt)
  }
}

Table payroll_items {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  payrollId varchar
  label varchar
  amount decimal
  isDeduction boolean [default: false]

  indexes {
    (tenantId, payrollId)
  }
}

Table tenants {
  lifecycleVersion integer [default: 0]
  legalHold boolean [default: false]
  retentionUntil timestamp [null]
  deletionNotBefore timestamp [null]
  id varchar [pk, default: `cuid(1)`]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  deletedAt timestamp [null]
  slug varchar [unique]
  companyName varchar
  taxNumber varchar [unique, null]
  taxOffice varchar [null]
  email varchar
  phone varchar [null]
  website varchar [null]
  address varchar [null]
  city varchar [null]
  country varchar [default: 'TR']
  sector varchar [null]
  plan Plan [default: 'STARTER']
  status TenantStatus [default: 'TRIAL']
  deploymentType DeploymentType [default: 'CLOUD']
  maxUsers integer [null, note: 'Null means unlimited users']
  userPrice decimal [null, note: 'Price per user in the tenant\'s subscription (e.g. 10.00 = $10/user)']
  trialEndsAt timestamp [null]
  subscriptionStart timestamp [null]
  subscriptionEnd timestamp [null]
  planChangedAt timestamp [null, note: 'DEĞİŞİKLİK 5: plan upgrade/downgrade zamanı']
  isCustomPricing boolean [default: false, note: 'DEĞİŞİKLİK 5: Enterprise müşteriler için fiyat tablosunu bypass et']
  modules AppModule[] [default: `ARRAY[]`]
  notes varchar [null]

  indexes {
    (status)
    (deletedAt)
  }
}

Table users {
  id varchar [pk, default: `cuid(1)`]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  deletedAt timestamp [null]
  email varchar [unique]
  name varchar
  phone varchar [null]
  password varchar
  isActive boolean [default: true]
  lastLoginAt timestamp [null]
  passwordResetToken varchar [null]
  passwordResetExpiry timestamp [null]

  indexes {
    (email)
    (deletedAt)
  }
}

Table admin_users {
  inviteTokenHash varchar [unique, null]
  invitationExpiresAt timestamp [null]
  invitationAcceptedAt timestamp [null]
  failedLoginCount integer [default: 0]
  lastFailedLoginAt timestamp [null]
  id varchar [pk, default: `cuid(1)`]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  email varchar [unique]
  name varchar
  password varchar
  isActive boolean [default: true]
  lastLoginAt timestamp [null]
  passwordChangedAt timestamp [default: `now()`]
  mfaSecretEncrypted varchar [null]
  mfaEnabled boolean [default: false]
  mfaLastCounter integer [default: -1]
  mfaVerifiedAt timestamp [null]
  tokenVersion integer [default: 0]
}

Table admin_sessions {
  tokenVersion integer [default: 0]
  id varchar [pk, default: `cuid(1)`]
  adminUserId varchar
  refreshTokenHash varchar [unique]
  deviceName varchar
  ipAddress varchar [null]
  userAgent varchar [null]
  rememberMe boolean [default: false]
  mfaVerifiedAt timestamp
  lastSeenAt timestamp [default: `now()`]
  expiresAt timestamp
  revokedAt timestamp [null]
  createdAt timestamp [default: `now()`]

  indexes {
    (adminUserId, revokedAt, expiresAt)
  }
}

Table admin_security_events {
  id varchar [pk, default: `cuid(1)`]
  adminUserId varchar
  type varchar
  message varchar
  ipAddress varchar [null]
  userAgent varchar [null]
  readAt timestamp [null]
  createdAt timestamp [default: `now()`]

  indexes {
    (adminUserId, createdAt)
  }
}

Table admin_roles {
  id varchar [pk, default: `cuid(1)`]
  key varchar [unique]
  name varchar
  description varchar [null]
}

Table admin_permissions {
  id varchar [pk, default: `cuid(1)`]
  key varchar [unique]
  description varchar [null]
}

Table admin_user_roles {
  adminUserId varchar
  adminRoleId varchar
  assignedAt timestamp [default: `now()`]

  indexes {
    (adminUserId, adminRoleId) [pk]
    (adminRoleId)
  }
}

Table admin_role_permissions {
  adminRoleId varchar
  adminPermissionId varchar

  indexes {
    (adminRoleId, adminPermissionId) [pk]
    (adminPermissionId)
  }
}

Table tenant_users {
  id varchar [pk, default: `cuid(1)`]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  tenantId varchar
  userId varchar
  roleId varchar [null]
  isOwner boolean [default: false]
  isActive boolean [default: true]
  preferences jsonb [null]

  indexes {
    (tenantId, userId) [unique]
    (tenantId)
    (userId)
  }
}

Table roles {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  name varchar
  description varchar [null]
  isSystem boolean [default: false]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']

  indexes {
    (tenantId, name) [unique]
  }
}

Table role_permissions {
  id varchar [pk, default: `cuid(1)`]
  roleId varchar
  module varchar
  action PermissionAction

  indexes {
    (roleId, module, action) [unique]
  }
}

Table plan_features {
  id varchar [pk, default: `cuid(1)`]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  plan Plan
  key varchar
  value varchar
  type FeatureType [default: 'LIMIT']
  isEnabled boolean [default: true]
  description varchar [null]
  featureKey FeatureKey [null]

  indexes {
    (plan, key) [unique]
    (plan, featureKey) [unique]
    (plan)
  }
}

Table tenant_feature_overrides {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  featureKey FeatureKey
  value varchar
  isEnabled boolean [default: true]
  reason varchar [null]
  expiresAt timestamp [null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  createdById varchar [null]

  indexes {
    (tenantId, featureKey) [unique]
    (tenantId)
  }
}

Table feature_rollouts {
  id varchar [pk, default: `cuid(1)`]
  plan Plan
  featureKey FeatureKey
  version integer
  environment varchar
  stage varchar
  status varchar [default: 'DRAFT']
  value varchar
  isEnabled boolean [default: true]
  rolloutPercentage integer [default: 0]
  targetTenantIds varchar[] [default: `ARRAY[]`]
  dependencies varchar[] [default: `ARRAY[]`]
  conflicts varchar[] [default: `ARRAY[]`]
  startsAt timestamp
  endsAt timestamp [null]
  errorThresholdPct decimal
  observedErrorRatePct decimal [null]
  killSwitch boolean [default: false]
  reason varchar
  ticketId varchar [null]
  createdById varchar
  activatedById varchar [null]
  activatedAt timestamp [null]
  pausedAt timestamp [null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']

  indexes {
    (plan, featureKey, environment, version) [unique]
    (plan, featureKey, environment, status)
    (status, startsAt, endsAt)
  }
}

Table api_keys {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  name varchar
  keyHash varchar [unique]
  keyPrefix varchar
  lastUsedAt timestamp [null]
  expiresAt timestamp [null]
  isActive boolean [default: true]
  scopes varchar[] [default: `ARRAY[]`]
  ipAllowlist varchar[] [default: `ARRAY[]`]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  deletedAt timestamp [null]
  createdById varchar [null]
  revokedAt timestamp [null]
  revokedById varchar [null]
  rotatedAt timestamp [null]
  rotatedFromId varchar [null]

  indexes {
    (tenantId, isActive)
    (tenantId, deletedAt)
    (tenantId, rotatedFromId)
  }
}

Table invitations {
  id varchar [pk, default: `cuid(1)`]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  tenantId varchar
  email varchar
  roleId varchar [null]
  status InvitationStatus [default: 'PENDING']
  tokenHash varchar [unique]
  expiresAt timestamp
  invitedBy varchar
  acceptedAt timestamp [null]

  indexes {
    (tenantId, email) [unique]
    (tenantId)
    (roleId)
    (status)
    (tokenHash)
  }
}

Table platform_incidents {
  id varchar [pk, default: `cuid(1)`]
  alertId varchar [null]
  title varchar
  summary varchar
  severity varchar
  status varchar [default: 'INVESTIGATING']
  owner varchar
  runbookUrl varchar
  rootCause varchar [null]
  resolution varchar [null]
  createdById varchar
  resolvedAt timestamp [null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']

  indexes {
    (status, severity, createdAt)
    (alertId)
  }
}

Table platform_incident_tenants {
  incidentId varchar
  tenantId varchar
  createdAt timestamp [default: `now()`]

  indexes {
    (incidentId, tenantId) [pk]
    (tenantId)
  }
}

Table platform_incident_timeline {
  id varchar [pk, default: `cuid(1)`]
  incidentId varchar
  type varchar
  message varchar
  createdById varchar
  createdAt timestamp [default: `now()`]

  indexes {
    (incidentId, createdAt)
  }
}

Table platform_incident_communications {
  id varchar [pk, default: `cuid(1)`]
  incidentId varchar
  message varchar
  status varchar [default: 'PENDING_APPROVAL']
  recipientCount integer
  requestedById varchar
  approvedById varchar [null]
  decisionNote varchar [null]
  publishedAt timestamp [null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']

  indexes {
    (incidentId, status, createdAt)
    (status, createdAt)
  }
}

Table warehouses {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  name varchar
  code varchar
  address varchar [null]
  isActive boolean [default: true]

  indexes {
    (tenantId, code) [unique]
    (tenantId)
  }
}

Table locations {
  id varchar [pk, default: `cuid(1)`]
  warehouseId varchar
  tenantId varchar
  name varchar
  code varchar
  isActive boolean [default: true]

  indexes {
    (warehouseId, code) [unique]
    (tenantId)
  }
}

Table stock_levels {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  productId varchar
  warehouseId varchar
  locationId varchar [default: '']
  quantity decimal [default: 0]
  updatedAt timestamp [note: 'Automatically updated timestamp']

  indexes {
    (productId, warehouseId, locationId) [unique]
    (tenantId, productId)
    (tenantId, warehouseId)
  }
}

Table stock_movements {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  productId varchar
  type MovementType
  quantity decimal
  unitCost decimal [null]
  totalCost decimal [null]
  fromWarehouseId varchar [null]
  toWarehouseId varchar [null]
  locationId varchar [null]
  lotId varchar [null]
  batchId varchar [null]
  refType MovementRefType [null]
  refId varchar [null]
  notes varchar [null]
  createdAt timestamp [default: `now()`]
  createdById varchar [null]
  idempotencyKey varchar [null]

  indexes {
    (tenantId, idempotencyKey) [unique]
    (tenantId, productId)
    (tenantId, type)
    (tenantId, createdAt)
    (tenantId, createdAt, type)
    (refType, refId)
  }
}

Table stock_valuations {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  productId varchar
  warehouseId varchar
  movementId varchar [null]
  date timestamp
  qtyIn decimal [default: 0]
  qtyOut decimal [default: 0]
  qtyBalance decimal [default: 0]
  unitCost decimal
  totalValue decimal
  createdAt timestamp [default: `now()`]

  indexes {
    (tenantId, productId)
    (tenantId, date)
  }
}

Table stock_counts {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  warehouseId varchar
  number varchar
  date timestamp
  isFinalized boolean [default: false]
  notes varchar [null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp [note: 'Automatically updated timestamp']
  createdById varchar [null]
  finalizedById varchar [null]
  finalizedAt timestamp [null]

  indexes {
    (tenantId, number) [unique]
  }
}

Table stock_count_items {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  stockCountId varchar
  productId varchar
  locationId varchar [null]
  expectedQty decimal
  countedQty decimal
  difference decimal

  indexes {
    (tenantId, stockCountId)
  }
}

Table inventory_reservations {
  id varchar [pk, default: `cuid(1)`]
  tenantId varchar
  productId varchar
  warehouseId varchar
  quantity decimal
