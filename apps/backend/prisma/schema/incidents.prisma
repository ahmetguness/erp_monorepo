model PlatformIncident {
  id             String   @id @default(cuid())
  alertId        String?
  title          String
  summary        String
  severity       String
  status         String   @default("INVESTIGATING")
  owner          String
  runbookUrl     String
  rootCause      String?
  resolution     String?
  createdById    String
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenants        PlatformIncidentTenant[]
  timeline       PlatformIncidentTimeline[]
  communications PlatformIncidentCommunication[]

  @@index([status, severity, createdAt])
  @@index([alertId])
  @@map("platform_incidents")
}

model PlatformIncidentTenant {
  incidentId String
  tenantId   String
  createdAt  DateTime @default(now())
  incident   PlatformIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@id([incidentId, tenantId])
  @@index([tenantId])
  @@map("platform_incident_tenants")
}

model PlatformIncidentTimeline {
  id          String   @id @default(cuid())
  incidentId  String
  type        String
  message     String
  createdById String
  createdAt   DateTime @default(now())
  incident    PlatformIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("platform_incident_timeline")
}

model PlatformIncidentCommunication {
  id             String   @id @default(cuid())
  incidentId     String
  message        String
  status         String   @default("PENDING_APPROVAL")
  recipientCount Int
  requestedById  String
  approvedById   String?
  decisionNote   String?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  incident       PlatformIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, status, createdAt])
  @@index([status, createdAt])
  @@map("platform_incident_communications")
}
