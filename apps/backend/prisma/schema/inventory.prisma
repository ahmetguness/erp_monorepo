// Domain: inventory
// Keep related enums and models together; cross-domain relations are resolved by Prisma.

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
  OPENING
}

enum ReservationRefType {
  SALES_ORDER
  WORK_ORDER
  PURCHASE_REQUEST
  OTHER
}

enum MovementRefType {
  PURCHASE_ORDER
  SALES_ORDER
  WORK_ORDER
  DELIVERY_NOTE
  STOCK_COUNT
  MANUAL
  OTHER
}

enum LotUsedRefType {
  SALES_ORDER
  WORK_ORDER
  DELIVERY_NOTE
  OTHER
}

model Warehouse {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  code     String
  address  String?
  isActive Boolean @default(true)

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations        Location[]
  stockLevels      StockLevel[]
  movementsFrom    StockMovement[]        @relation("MovementFrom")
  movementsTo      StockMovement[]        @relation("MovementTo")
  stockCounts      StockCount[]
  reservations     InventoryReservation[]
  deliveryNotes    DeliveryNote[]
  // Fix #5: back-relations for WorkOrder warehouse references
  workOrdersInput  WorkOrder[]            @relation("WorkOrderInputWarehouse")
  workOrdersOutput WorkOrder[]            @relation("WorkOrderOutputWarehouse")
  workOrderItems   WorkOrderItem[]        @relation("WorkOrderItemSourceWarehouse")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

model Location {
  id          String  @id @default(cuid())
  warehouseId String
  tenantId    String
  name        String
  code        String
  isActive    Boolean @default(true)

  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  // Fix #4: locationId on StockLevel uses empty string "" as sentinel for "no location"
  stockLevels StockLevel[]
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, code])
  @@index([tenantId])
  @@map("locations")
}

model StockLevel {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  warehouseId String
  locationId  String   @default("")
  quantity    Decimal  @db.Decimal(18, 3) @default(0)
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  // Empty string sentinel means no location; relation is optional at app layer
  location  Location? @relation(fields: [locationId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId, locationId])
  @@index([tenantId, productId])
  @@index([tenantId, warehouseId])
  @@map("stock_levels")
}

model StockMovement {
  id              String       @id @default(cuid())
  tenantId        String
  productId       String
  type            MovementType
  quantity        Decimal      @db.Decimal(18, 3)
  unitCost        Decimal?     @db.Decimal(18, 4)
  totalCost       Decimal?     @db.Decimal(18, 2)
  fromWarehouseId String?
  toWarehouseId   String?
  locationId      String?
  lotId           String?      // LotSerialNumber reference
  batchId         String?      // ProductBatch reference
  refType         MovementRefType?
  refId           String?
  notes           String?
  createdAt       DateTime     @default(now())
  createdById     String?

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse? @relation("MovementFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse? @relation("MovementTo", fields: [toWarehouseId], references: [id])
  lot           LotSerialNumber? @relation("LotMovements", fields: [lotId], references: [id])
  batch         ProductBatch?    @relation("BatchMovements", fields: [batchId], references: [id])

  @@index([tenantId, productId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([tenantId, createdAt, type])
  @@index([refType, refId])
  @@map("stock_movements")
}

model StockValuation {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  warehouseId String
  movementId  String?
  date        DateTime
  qtyIn       Decimal  @db.Decimal(18, 3) @default(0)
  qtyOut      Decimal  @db.Decimal(18, 3) @default(0)
  qtyBalance  Decimal  @db.Decimal(18, 3) @default(0)
  unitCost    Decimal  @db.Decimal(18, 4)
  totalValue  Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@index([tenantId, date])
  @@map("stock_valuations")
}

model StockCount {
  id            String   @id @default(cuid())
  tenantId      String
  warehouseId   String
  number        String
  date          DateTime
  isFinalized   Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  finalizedById String?
  finalizedAt   DateTime?

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  items     StockCountItem[]

  @@unique([tenantId, number])
  @@map("stock_counts")
}

model StockCountItem {
  id           String  @id @default(cuid())
  tenantId     String
  stockCountId String
  productId    String
  locationId   String?
  expectedQty  Decimal @db.Decimal(18, 3)
  countedQty   Decimal @db.Decimal(18, 3)
  difference   Decimal @db.Decimal(18, 3)

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, stockCountId])
  @@map("stock_count_items")
}

model InventoryReservation {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  warehouseId String
  quantity    Decimal  @db.Decimal(18, 3)
  refType     ReservationRefType
  refId       String
  notes       String?
  reservedAt  DateTime @default(now())
  expiresAt   DateTime?
  releasedAt  DateTime?
  createdById String?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, productId])
  @@index([tenantId, refType, refId])
  @@map("inventory_reservations")
}

model ProductBatch {
  id             String    @id @default(cuid())
  tenantId       String
  productId      String
  batchNumber    String
  expiryDate     DateTime? @db.Date
  manufacturedAt DateTime? @db.Date
  quantity       Decimal   @db.Decimal(18, 3) @default(0)
  notes          String?
  createdAt      DateTime  @default(now())

  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lots          LotSerialNumber[]
  movements     StockMovement[]    @relation("BatchMovements")
  deliveryItems DeliveryNoteItem[] @relation("BatchDeliveryItems")

  @@unique([tenantId, productId, batchNumber])
  @@index([tenantId, productId])
  @@map("product_batches")
}

model LotSerialNumber {
  id           String    @id @default(cuid())
  tenantId     String
  productId    String
  batchId      String?
  serialNumber String
  isUsed       Boolean   @default(false)
  usedAt       DateTime?
  usedRefType  LotUsedRefType?
  usedRefId    String?
  createdAt    DateTime  @default(now())

  batch         ProductBatch? @relation(fields: [batchId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements     StockMovement[]    @relation("LotMovements")
  deliveryItems DeliveryNoteItem[] @relation("LotDeliveryItems")

  @@unique([tenantId, productId, serialNumber])
  @@index([tenantId, productId])
  @@map("lot_serial_numbers")
}
