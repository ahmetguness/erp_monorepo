// Domain: platform
// Keep related enums and models together; cross-domain relations are resolved by Prisma.

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  EXPORT
  LOGIN
  LOGOUT
  OTHER
}

enum CurrencyRateSource {
  MANUAL
  CENTRAL_BANK
  API
}

enum EntityType {
  INVOICE
  PRODUCT
  CATEGORY
  CONTACT
  EMPLOYEE
  CUSTOMER_ASSET
  SERVICE_REQUEST
  PURCHASE_ORDER
  SALES_QUOTE
  SALES_ORDER
  WORK_ORDER
  DELIVERY_NOTE
  OTHER
}

enum AiRequestType {
  PRIVATE_CHAT
  PUBLIC_CHAT
  MAIL_DRAFT
  SMART_FORM
  RECOMMENDED_ACTION
  OTHER
}

enum AiRequestStatus {
  STARTED
  SUCCEEDED
  FAILED
  FALLBACK
}

enum AiPermissionCheckResult {
  NOT_REQUIRED
  ALLOWED
  DENIED
  PARTIAL
}

model NumberSequence {
  id       String @id @default(cuid())
  tenantId String
  module   String
  prefix   String @default("")
  lastNum  Int    @default(0)
  padding  Int    @default(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@map("number_sequences")
}

model TenantSetting {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("tenant_settings")
}

model ModuleSetting {
  id        String   @id @default(cuid())
  tenantId  String
  module    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module, key])
  @@index([tenantId, module])
  @@map("module_settings")
}

enum AdminChangeRequestType {
  TENANT_PLAN_UPDATE
  TENANT_STATUS_UPDATE
  PLAN_FEATURE_UPDATE
  FEATURE_OVERRIDE_UPSERT
  FEATURE_OVERRIDE_DELETE
  FEATURE_ROLLOUT_ACTIVATE
}

enum AdminChangeRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  APPLIED
  ROLLED_BACK
}

model AdminChangeRequest {
  id                     String                   @id @default(cuid())
  type                   AdminChangeRequestType
  status                 AdminChangeRequestStatus @default(PENDING)
  targetId               String
  targetLabel            String
  requiredPermission     String
  payload                Json
  previousValues         Json?
  affectedTenantCount    Int                      @default(0)
  affectedUserCount      Int                      @default(0)
  requestedById          String
  decidedById            String?
  decisionNote           String?
  reason                 String
  ticketId               String?
  rollbackOfId           String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  decidedAt              DateTime?
  appliedAt              DateTime?

  requestedBy AdminUser  @relation("AdminChangeRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   AdminUser? @relation("AdminChangeRequestDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([requestedById, status])
  @@index([type, targetId, status])
  @@index([rollbackOfId])
  @@map("admin_change_requests")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  module     String
  entityType EntityType
  entityId   String
  action     AuditAction
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  adminId     String?
  reason      String?
  ticketId    String?
  requestId   String?
  approvalId  String?
  rollbackOfId String?
  createdAt  DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admin  AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([tenantId, module])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@index([adminId, createdAt])
  @@index([requestId])
  @@index([approvalId])
  @@map("audit_logs")
}

model TenantSupportNote {
  id String @id @default(cuid())
  tenantId String
  authorId String
  body String
  ticketId String?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author AdminUser @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([tenantId, createdAt])
  @@map("tenant_support_notes")
}

model SupportSession {
  id String @id @default(cuid())
  tenantId String
  adminId String
  adminSessionId String
  targetUserId String
  reason String
  ticketId String
  scopes String[]
  expiresAt DateTime
  approvedAt DateTime?
  approvedById String?
  revokedAt DateTime?
  writeRequested Boolean @default(false)
  writeApprovedAt DateTime?
  writeApprovedById String?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)
  targetUser User @relation(fields: [targetUserId], references: [id], onDelete: Restrict)
  @@index([tenantId, createdAt])
  @@index([adminId, expiresAt])
  @@map("support_sessions")
}

model TenantLifecycleRequest {
  id String @id @default(cuid())
  tenantId String
  fromStatus TenantStatus
  version Int
  input Json
  state String @default("PENDING")
  requestedById String
  requestedByName String
  decidedById String?
  createdAt DateTime @default(now())
  decidedAt DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
  @@map("tenant_lifecycle_requests")
}

model TenantLifecycleExport {
  id String @id @default(cuid())
  tenantId String
  version Int
  digest String
  data Json
  createdById String
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
  @@map("tenant_lifecycle_exports")
}

model TenantProvisioningJob {
  id String @id @default(cuid())
  provisionedTenantId String? @map("tenantId")
  idempotencyKey String @unique
  requestHash String
  input Json
  status String @default("PENDING")
  error String?
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant? @relation(fields: [provisionedTenantId], references: [id], onDelete: SetNull)
  steps TenantProvisioningStep[]
  @@index([provisionedTenantId, createdAt])
  @@map("tenant_provisioning_jobs")
}

model TenantProvisioningStep {
  id String @id @default(cuid())
  jobId String
  key String
  status String @default("PENDING")
  attempts Int @default(0)
  error String?
  updatedAt DateTime @updatedAt
  job TenantProvisioningJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([jobId, key])
  @@map("tenant_provisioning_steps")
}

model BillingSubscription {
  id String @id @default(cuid())
  tenantId String @unique
  provider String @default("MANUAL")
  providerCustomerId String?
  state String @default("TRIALING")
  monthlyAmount Decimal @default(0) @db.Decimal(12, 2)
  currency String @default("TRY")
  dunningAttempt Int @default(0)
  nextRetryAt DateTime?
  customUnitPrice Decimal? @db.Decimal(12, 2)
  customPricingExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("billing_subscriptions")
}

model BillingInvoice {
  id String @id @default(cuid())
  tenantId String
  providerInvoiceId String?
  amount Decimal @db.Decimal(12, 2)
  currency String @default("TRY")
  status String @default("OPEN")
  dueAt DateTime
  paidAt DateTime?
  failureReason String?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
  @@unique([tenantId, providerInvoiceId])
  @@map("billing_invoices")
}

model BillingProviderEvent {
  id String @id @default(cuid())
  provider String
  providerEventId String
  type String
  payload Json
  processedAt DateTime @default(now())
  @@unique([provider, providerEventId])
  @@map("billing_provider_events")
}

model BillingCoupon {
  id String @id @default(cuid())
  code String @unique
  percent Int
  expiresAt DateTime
  maxRedemptions Int?
  redemptionCount Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  discounts SubscriptionDiscount[]
  @@map("billing_coupons")
}

model SubscriptionDiscount {
  id String @id @default(cuid())
  tenantId String
  couponId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coupon BillingCoupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  @@unique([tenantId, couponId])
  @@index([tenantId, expiresAt])
  @@map("subscription_discounts")
}

model CustomPriceRequest {
  id String @id @default(cuid())
  tenantId String
  monthlyAmount Decimal @db.Decimal(12, 2)
  unitPrice Decimal? @db.Decimal(12, 2)
  expiresAt DateTime
  reason String
  state String @default("PENDING")
  requestedById String
  decidedById String?
  createdAt DateTime @default(now())
  decidedAt DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
  @@map("custom_price_requests")
}

model AiRequestLog {
  id                    String                  @id @default(cuid())
  tenantId              String?
  userId                String?
  requestType           AiRequestType
  promptVersion         String
  model                 String
  entityType            EntityType?
  entityId              String?
  entityContext         Json?
  permissionCheckResult AiPermissionCheckResult @default(NOT_REQUIRED)
  redactedFields        String[]                @default([])
  inputSummary          String?
  outputSummary         String?
  draft                 Json?
  result                Json?
  userApprovedAction    String?
  status                AiRequestStatus         @default(STARTED)
  usedTools             Boolean                 @default(false)
  tokenPrompt           Int?
  tokenCompletion       Int?
  tokenTotal            Int?
  errorMessage          String?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime                @default(now())
  completedAt           DateTime?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, requestType, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([userId, createdAt])
  @@map("ai_request_logs")
}

model Attachment {
  id              String   @id @default(cuid())
  tenantId        String
  entityType      EntityType
  entityId        String
  fileName        String
  storagePath     String
  mimeType        String?
  fileSize        Int?     // bytes
  category        String?
  tags            String[] @default([])
  documentKind    String?
  confidentiality String?
  validFrom       DateTime?
  validUntil      DateTime?
  version         Int      @default(1)
  uploadedById    String?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, category])
  @@index([tenantId, uploadedById])
  @@map("attachments")
}

model Notification {
  id         String             @id @default(cuid())
  tenantId   String
  userId     String
  title      String
  message    String?
  module     String?
  entityType EntityType?
  entityId   String?
  status     NotificationStatus @default(UNREAD)
  createdAt  DateTime           @default(now())
  readAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

model Currency {
  id       String   @id @default(cuid())
  tenantId String
  code     String
  name     String
  symbol   String
  /// Fallback rate when no CurrencyRate row exists for a given date
  defaultRate Decimal  @db.Decimal(18, 6) @default(1)
  isBase   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("currencies")
}

model CurrencyRate {
  id           String   @id @default(cuid())
  tenantId     String
  currencyCode String
  rate         Decimal  @db.Decimal(18, 6)
  date         DateTime @db.Date
  source       CurrencyRateSource?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, currencyCode, date])
  @@index([tenantId, currencyCode])
  @@index([tenantId, date])
  @@map("currency_rates")
}
