// Domain: platform
// Keep related enums and models together; cross-domain relations are resolved by Prisma.

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  EXPORT
  LOGIN
  LOGOUT
  OTHER
}

enum CurrencyRateSource {
  MANUAL
  CENTRAL_BANK
  API
}

enum EntityType {
  INVOICE
  PRODUCT
  CATEGORY
  CONTACT
  EMPLOYEE
  CUSTOMER_ASSET
  SERVICE_REQUEST
  PURCHASE_ORDER
  SALES_QUOTE
  SALES_ORDER
  WORK_ORDER
  DELIVERY_NOTE
  OTHER
}

enum AiRequestType {
  PRIVATE_CHAT
  PUBLIC_CHAT
  MAIL_DRAFT
  SMART_FORM
  RECOMMENDED_ACTION
  OTHER
}

enum AiRequestStatus {
  STARTED
  SUCCEEDED
  FAILED
  FALLBACK
}

enum AiPermissionCheckResult {
  NOT_REQUIRED
  ALLOWED
  DENIED
  PARTIAL
}

model NumberSequence {
  id       String @id @default(cuid())
  tenantId String
  module   String
  prefix   String @default("")
  lastNum  Int    @default(0)
  padding  Int    @default(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module])
  @@map("number_sequences")
}

model TenantSetting {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("tenant_settings")
}

model ModuleSetting {
  id        String   @id @default(cuid())
  tenantId  String
  module    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module, key])
  @@index([tenantId, module])
  @@map("module_settings")
}

enum AdminChangeRequestType {
  TENANT_PLAN_UPDATE
  TENANT_STATUS_UPDATE
  PLAN_FEATURE_UPDATE
  FEATURE_OVERRIDE_UPSERT
  FEATURE_OVERRIDE_DELETE
}

enum AdminChangeRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  APPLIED
  ROLLED_BACK
}

model AdminChangeRequest {
  id                     String                   @id @default(cuid())
  type                   AdminChangeRequestType
  status                 AdminChangeRequestStatus @default(PENDING)
  targetId               String
  targetLabel            String
  requiredPermission     String
  payload                Json
  previousValues         Json?
  affectedTenantCount    Int                      @default(0)
  affectedUserCount      Int                      @default(0)
  requestedById          String
  decidedById            String?
  decisionNote           String?
  reason                 String
  ticketId               String?
  rollbackOfId           String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  decidedAt              DateTime?
  appliedAt              DateTime?

  requestedBy AdminUser  @relation("AdminChangeRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   AdminUser? @relation("AdminChangeRequestDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([requestedById, status])
  @@index([type, targetId, status])
  @@index([rollbackOfId])
  @@map("admin_change_requests")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  module     String
  entityType EntityType
  entityId   String
  action     AuditAction
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  adminId     String?
  reason      String?
  ticketId    String?
  requestId   String?
  approvalId  String?
  rollbackOfId String?
  createdAt  DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admin  AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([tenantId, module])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@index([adminId, createdAt])
  @@index([requestId])
  @@index([approvalId])
  @@map("audit_logs")
}

model TenantSupportNote {
  id String @id @default(cuid())
  tenantId String
  authorId String
  body String
  ticketId String?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author AdminUser @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([tenantId, createdAt])
  @@map("tenant_support_notes")
}

model AiRequestLog {
  id                    String                  @id @default(cuid())
  tenantId              String?
  userId                String?
  requestType           AiRequestType
  promptVersion         String
  model                 String
  entityType            EntityType?
  entityId              String?
  entityContext         Json?
  permissionCheckResult AiPermissionCheckResult @default(NOT_REQUIRED)
  redactedFields        String[]                @default([])
  inputSummary          String?
  outputSummary         String?
  draft                 Json?
  result                Json?
  userApprovedAction    String?
  status                AiRequestStatus         @default(STARTED)
  usedTools             Boolean                 @default(false)
  tokenPrompt           Int?
  tokenCompletion       Int?
  tokenTotal            Int?
  errorMessage          String?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime                @default(now())
  completedAt           DateTime?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, requestType, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([userId, createdAt])
  @@map("ai_request_logs")
}

model Attachment {
  id              String   @id @default(cuid())
  tenantId        String
  entityType      EntityType
  entityId        String
  fileName        String
  storagePath     String
  mimeType        String?
  fileSize        Int?     // bytes
  category        String?
  tags            String[] @default([])
  documentKind    String?
  confidentiality String?
  validFrom       DateTime?
  validUntil      DateTime?
  version         Int      @default(1)
  uploadedById    String?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, category])
  @@index([tenantId, uploadedById])
  @@map("attachments")
}

model Notification {
  id         String             @id @default(cuid())
  tenantId   String
  userId     String
  title      String
  message    String?
  module     String?
  entityType EntityType?
  entityId   String?
  status     NotificationStatus @default(UNREAD)
  createdAt  DateTime           @default(now())
  readAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

model Currency {
  id       String   @id @default(cuid())
  tenantId String
  code     String
  name     String
  symbol   String
  /// Fallback rate when no CurrencyRate row exists for a given date
  defaultRate Decimal  @db.Decimal(18, 6) @default(1)
  isBase   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("currencies")
}

model CurrencyRate {
  id           String   @id @default(cuid())
  tenantId     String
  currencyCode String
  rate         Decimal  @db.Decimal(18, 6)
  date         DateTime @db.Date
  source       CurrencyRateSource?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, currencyCode, date])
  @@index([tenantId, currencyCode])
  @@index([tenantId, date])
  @@map("currency_rates")
}
