model AdminInboxItemState {
  id         String    @id @default(cuid())
  adminId    String
  sourceType String
  sourceId   String
  ownerId    String?
  readAt     DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  admin AdminUser @relation("AdminInboxReadStates", fields: [adminId], references: [id], onDelete: Cascade)
  owner AdminUser? @relation("LegacyAdminInboxOwners", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([adminId, sourceType, sourceId])
  @@index([adminId, resolvedAt, updatedAt])
  @@index([ownerId, resolvedAt])
  @@map("admin_inbox_item_states")
}

model AdminInboxPreference {
  adminId     String   @id
  approvals   Boolean  @default(true)
  security    Boolean  @default(true)
  incidents   Boolean  @default(true)
  expirations Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_inbox_preferences")
}

model AdminInboxTaskState {
  id         String    @id @default(cuid())
  sourceType String
  sourceId   String
  ownerId    String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  owner AdminUser? @relation("AdminInboxTaskOwners", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId])
  @@index([ownerId, resolvedAt])
  @@map("admin_inbox_task_states")
}
