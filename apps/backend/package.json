{
  "name": "@repo/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker:domain-events": "tsx src/workers/domain-event-outbox.worker.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "npm run test:typecheck && npm run test:prisma-architecture && npm run test:module-boundaries && npm run test:unit && npm run test:integration",
    "test:typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:unit:coverage": "vitest run --coverage --config vitest.config.mts",
    "test:code-quality": "node --import ../../scripts/node26-tsx-shim.mjs --import tsx scripts/check-code-quality.ts",
    "test:module-boundaries": "node --import ../../scripts/node26-tsx-shim.mjs --import tsx scripts/check-module-boundaries.ts",
    "test:contracts": "node --import ../../scripts/node26-tsx-shim.mjs --import tsx scripts/check-api-contracts.ts",
    "test:integration": "node --import ../../scripts/node26-tsx-shim.mjs --import tsx scripts/run-integration-tests.ts",
    "test:web-smoke": "node --import ../../scripts/node26-tsx-shim.mjs --import tsx scripts/check-web-smoke-flows.ts",
    "test:e2e": "npm run test:web-smoke",
    "test:tenant-isolation": "node --import ../../scripts/node26-tsx-shim.mjs --import tsx scripts/check-tenant-isolation.ts",
    "test:tenant-runtime": "node --import ../../scripts/node26-tsx-shim.mjs --import tsx scripts/check-runtime-tenant-guard.ts",
    "test:permission-gating": "node --import ../../scripts/node26-tsx-shim.mjs --import tsx scripts/check-permission-gating.ts",
    "test:prisma-architecture": "node --import ../../scripts/node26-tsx-shim.mjs --import tsx scripts/check-prisma-architecture.ts && prisma validate",
    "test:quality": "npm run test:typecheck && npm run test:prisma-architecture && npm run test:unit:coverage && npm run test:code-quality && npm run test:module-boundaries && npm run test:contracts && npm run test:tenant-isolation && npm run test:tenant-runtime && npm run test:permission-gating && npm run test:e2e && npm run test:integration && npm run db:health",
    "ci:artifacts": "tsx scripts/generate-ci-artifacts.ts",
    "start": "node dist/src/index.js",
    "db:health": "node --import ../../scripts/node26-tsx-shim.mjs --import tsx scripts/check-db-health.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:dry-run": "node --import ../../scripts/node26-tsx-shim.mjs --import tsx scripts/migration-dry-run.ts",
    "db:migrate:review": "node --import ../../scripts/node26-tsx-shim.mjs --import tsx scripts/check-migration-safety.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "storage:migrate": "tsx scripts/migrate-local-storage-to-object-storage.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@prisma/client": "^6.19.0",
    "@repo/types": "file:../../packages/types",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "hono": "^4.12.27",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.35.0",
    "resend": "^6.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
